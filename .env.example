# Copia este archivo a ".env" y pega tus credenciales de Supabase.
# Las encuentras en: Supabase Dashboard -> Project Settings -> API
#
# Estas dos claves son PÚBLICAS (van en el frontend). La seguridad real
# la dan las políticas RLS en la base de datos, no el secreto de la clave.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key
